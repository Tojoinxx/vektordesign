{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vektordesign",
  "version": "../package.json",
  "identifier": "de.vektordesign.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vektordesign",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Tony Lam",
    "copyright": "© 2026 Tony Lam",
    "category": "GraphicsAndDesign",
    "shortDescription": "Maßgenaue Vektorgrafik für Textil-Designs",
    "longDescription": "Vektordesign: 2D-Vektorgrafik mit Bemaßungen und Abhängigkeiten wie im Inventor-Skizzenmodus, Export als SVG und PNG für Druck und Plotter.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
